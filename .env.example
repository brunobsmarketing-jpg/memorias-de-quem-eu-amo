# OpenAI - texto emocional (LLM), extração de temas visuais e geração de imagens ilustrativas
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# ElevenLabs - narração profissional e clonagem de voz
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase - banco de dados (Postgres) + storage de arquivos (fotos, áudio, vídeos renderizados).
# Usado tanto pelo produto de vídeo quanto pelo Livro de Memórias (mesma conta/créditos).
SUPABASE_URL="MY_SUPABASE_PROJECT_URL"
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# Mercado Pago - cobrança real dos pacotes de crédito (Checkout Pro).
# Access Token: painel Mercado Pago > Suas integrações > (sua aplicação) > Credenciais.
# Use as credenciais de TESTE enquanto desenvolve, e troque pelas de PRODUÇÃO só no lançamento.
MERCADOPAGO_ACCESS_TOKEN="MY_MERCADOPAGO_ACCESS_TOKEN"
# Secret de assinatura do webhook: painel Mercado Pago > Suas integrações > (sua aplicação) >
# Webhooks > "Chave secreta" — usado para confirmar que a notificação realmente veio da Mercado
# Pago antes de liberar qualquer crédito (ver /api/webhook/mercadopago em server.ts).
MERCADOPAGO_WEBHOOK_SECRET="MY_MERCADOPAGO_WEBHOOK_SECRET"

# Payt - usada só para a COMPRA INICIAL (virar membro pago), feita numa página de vendas fora
# deste app. Escolha você mesmo uma string aleatória longa (ex: gere com `openssl rand -hex 32`)
# e configure o webhook no painel da Payt apontando para:
#   https://SEU_DOMINIO/api/webhook/payt/ESSE_VALOR_AQUI
# (o valor vai embutido na própria URL, não como header, porque a Payt não documenta assinatura).
PAYT_WEBHOOK_SECRET="MY_PAYT_WEBHOOK_SECRET"

# Resend - envia o e-mail de "acesso liberado" depois que o webhook da Payt confirma a compra
# inicial (o login é só por e-mail, sem senha, então a pessoa precisa saber que já pode entrar).
# Pegue a API key em resend.com/api-keys depois de verificar o domínio de envio.
RESEND_API_KEY="MY_RESEND_API_KEY"
# Remetente do e-mail — precisa ser um domínio/subdomínio verificado no Resend.
EMAIL_FROM="Memórias de Quem Eu Amo <acesso@mail.memoriasdequemeuamo.com.br>"
